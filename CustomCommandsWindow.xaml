<Window x:Class="FiveMOverlay.CustomCommandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eigene Chat-Befehle" Height="560" Width="850"
        MinHeight="430" MinWidth="680" WindowStartupLocation="CenterOwner"
        Background="#FF202020" Foreground="#FFF2F4F8">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Eigene Chat-Befehle" FontSize="24" FontWeight="Bold"/>
            <TextBlock Margin="0,6,0,0" Foreground="#FFB7B7B7" TextWrapping="Wrap"
                       Text="Tippe den Auslöser im FiveM-Chat und drücke die Leertaste. Der Text wird ersetzt, aber niemals automatisch abgeschickt. Verwende {cursor} an der Stelle, an der du weitertippen möchtest."/>
        </StackPanel>
        <DataGrid x:Name="CommandsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True"
                  CanUserDeleteRows="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="#FF292929" Foreground="#FFF2F4F8" RowBackground="#FF292929"
                  AlternatingRowBackground="#FF333333" BorderBrush="#FF414141" CanUserSortColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow" Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Auslöser (z. B. /br)" Binding="{Binding Trigger, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridTextColumn Header="Einzufügender Text (z. B. /su {cursor} br)" Binding="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" LastChildFill="True">
            <Button Content="Beispiel hinzufügen" Click="AddExample_Click" DockPanel.Dock="Left" Padding="12,8"
                    Background="#FF3A3A3A" Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
            <Button Content="Abbrechen" Click="Cancel_Click" DockPanel.Dock="Right" Padding="16,8"
                    Background="#FF3A3A3A" Foreground="White" BorderThickness="0" Margin="8,0,0,0"/>
            <Button Content="Speichern" Click="Save_Click" DockPanel.Dock="Right" Padding="16,8"
                    Background="#FFAE3F3D" Foreground="White" BorderThickness="0"/>
            <TextBlock x:Name="DialogStatus" VerticalAlignment="Center" Foreground="#FFC95452" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
