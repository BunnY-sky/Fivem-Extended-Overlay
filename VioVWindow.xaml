<Window x:Class="FiveMOverlay.VioVWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FiveMOverlay | Vio-V Zugang" Height="760" Width="1040" MinHeight="660" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="#FF202020" Foreground="#FFF4F7FF"
        ResizeMode="CanResize" ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFB7B7B7"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF292929"/><Setter Property="BorderBrush" Value="#FF414141"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="16"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" CornerRadius="18" Padding="22" Background="#FF252525" BorderBrush="#FF414141" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <Border Width="62" Height="62" CornerRadius="14" Background="#FF202020" HorizontalAlignment="Left" Padding="5" BorderBrush="#FF3A3A3A" BorderThickness="1">
                        <Image Source="VioVLogo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Vio-V Logo"/>
                    </Border>
                    <TextBlock Text="VIO-V" FontSize="27" FontWeight="ExtraBold" Margin="0,18,0,0" Foreground="#FFF5F8FF"/>
                    <TextBlock Text="FIVEMOVERLAY" FontSize="10" FontWeight="Bold" Foreground="#FFC95452" Margin="1,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="DEIN ZUGANG.\nDEIN OVERLAY." FontSize="24" FontWeight="Bold" LineHeight="30" TextWrapping="Wrap"/>
                    <TextBlock Text="Melde dich über Vio-V an, um die Anwendung freizuschalten." FontSize="13" Foreground="#FFB7B7B7" TextWrapping="Wrap" Margin="0,13,0,0" LineHeight="20"/>
                    <StackPanel Margin="0,26,0,0">
                        <DockPanel Margin="0,0,0,13">
                            <Border Width="28" Height="28" CornerRadius="9" Background="#FF382326" DockPanel.Dock="Left" Margin="0,0,10,0"><TextBlock Text="✓" Foreground="#FFC95452" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel><TextBlock Text="Offizieller Login" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Authentifizierung über Vio-V" Foreground="#FFAAAAAA" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,13">
                            <Border Width="28" Height="28" CornerRadius="9" Background="#FF382326" DockPanel.Dock="Left" Margin="0,0,10,0"><TextBlock Text="⌁" Foreground="#FFC95452" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel><TextBlock Text="PKCE geschützt" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Kein Passwort im Programm" Foreground="#FFAAAAAA" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                        </DockPanel>
                        <DockPanel>
                            <Border Width="28" Height="28" CornerRadius="9" Background="#FF382326" DockPanel.Dock="Left" Margin="0,0,10,0"><TextBlock Text="●" Foreground="#FFC95452" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel><TextBlock Text="Login erforderlich" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Ohne Anmeldung kein Zugriff" Foreground="#FFAAAAAA" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Border Height="1" Background="#FF414141" Margin="0,0,0,12"/>
                    <TextBlock Text="VIO-V CONNECT  •  SECURE ACCESS" FontSize="9" Foreground="#FF7085A7" FontWeight="Bold"/>
                    <TextBlock Text="FiveMOverlay · OAuth2 + PKCE" FontSize="10" Foreground="#FF7085A7" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,4,0,20">
                <TextBlock Text="Willkommen zurück" FontSize="29" FontWeight="Bold"/>
                <TextBlock Text="Verbinde dein Vio-V-Konto, um fortzufahren." FontSize="13" Foreground="#FFB7B7B7" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="SICHER ANMELDEN" Style="{StaticResource SmallLabel}"/>
                        <TextBlock Text="Mit deinem Vio-V-Konto fortfahren" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0"/>
                        <TextBlock Text="Dein Browser öffnet die offizielle Vio-V-Anmeldeseite." FontSize="11" Foreground="#FFB7B7B7" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button x:Name="LoginButton" Grid.Column="1" Content="Mit Vio-V anmelden  →" Click="LoginButton_Click" Padding="18,13" MinWidth="190" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="#FF2B1B1D" BorderBrush="#FF75413F" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                <DockPanel>
                    <Ellipse Width="8" Height="8" Fill="#FFC95452" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Nicht angemeldet · Bitte melde dich an, um die Anwendung freizuschalten." Foreground="#FFFFDAD8" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button x:Name="RefreshButton" Content="Aktualisieren" Click="RefreshButton_Click" Visibility="Collapsed" DockPanel.Dock="Right" Margin="10,0,0,0" Padding="10,5"/>
                </DockPanel>
            </Border>
            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="KONTOÜBERSICHT" Style="{StaticResource SmallLabel}" Margin="2,0,0,10"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><TextBlock Text="SPIELERNAME" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="PlayerNameText" Text="Gesperrt" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="FRAKTION / GRUPPE" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="FactionText" Text="—" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="RANG" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="RankText" Text="—" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
                </Grid>
            </Grid>
            <Expander Grid.Row="4" Header="Technische API-Diagnose" Foreground="#FFB7B7B7" FontSize="11" Margin="0,0,0,4">
                <TextBox x:Name="RawJsonText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10" Padding="10" Background="#FF1C1C1C" Foreground="#FFD7DFEC" BorderBrush="#FF414141" Height="105"/>
            </Expander>
            <TextBlock Grid.Row="5" Text="Deine Zugangsdaten werden ausschließlich auf der offiziellen Vio-V-Seite eingegeben." Foreground="#FF7185A5" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,0,0,0" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
