<Window x:Class="FiveMOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FiveM Overlay" Height="790" Width="1280" MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen" Background="#FF202020" Foreground="#FFF2F4F8">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#FFD7D7D7"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,3,0,3"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFC95452"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF1C1C1C"/><Setter Property="Foreground" Value="#FFF2F4F8"/>
            <Setter Property="BorderBrush" Value="#FF414141"/><Setter Property="CaretBrush" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FF181818" BorderBrush="#FF353535" BorderThickness="0,0,1,0" Padding="15">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="6,8,6,24">
                    <TextBlock Text="FiveMOverlay" FontSize="23" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="VIO-V CONNECTED" FontSize="10" FontWeight="Bold" Foreground="#FFC95452" Margin="1,5,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <Border Height="1" Background="#FF383838" Margin="0,0,0,12"/>
                    <Button Content="⚙  Einstellungen speichern" Click="Save_Click" Style="{StaticResource NavButton}"/>
                    <TextBlock Text="NUMPAD 0–3 · globale Hotkeys" FontSize="10" Foreground="#FF888888" TextWrapping="Wrap" Margin="8,8,0,0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="MENÜ" Foreground="#FF777777" FontSize="10" FontWeight="Bold" Margin="8,0,0,7"/>
                    <Button Content="⌂   Home" Click="NavHome_Click" Style="{StaticResource NavButton}"/>
                    <TextBlock Text="OVERLAYS" Foreground="#FF777777" FontSize="10" FontWeight="Bold" Margin="8,18,0,5"/>
                    <Button x:Name="NavOverlay1Button" Content="▤   Overlay 1" Click="NavOverlay1_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="NavOverlay2Button" Content="▤   Overlay 2" Click="NavOverlay2_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="NavOverlay3Button" Content="▤   Overlay 3" Click="NavOverlay3_Click" Style="{StaticResource NavButton}"/>
                    <TextBlock Text="VERWALTUNG" Foreground="#FF777777" FontSize="10" FontWeight="Bold" Margin="8,18,0,5"/>
                    <Button Content="⌨   Shortcuts &amp; Chat-Befehle" Click="NavShortcuts_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="⚙   Overlay-Einstellungen" Click="NavSettings_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="◎   Vio-V Konto" Click="OpenVioV_Click" Style="{StaticResource NavButton}" Margin="0,18,0,3"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="26,22,26,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock x:Name="PageTitleText" Text="Home" FontSize="28" FontWeight="Bold"/>
                <TextBlock x:Name="PageSubtitleText" Text="Deine Spielerinformationen und dein Overlay auf einen Blick." Foreground="#FFB7B7B7" FontSize="13" Margin="0,5,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#FF292929" BorderBrush="#FF414141" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="SPIELERÜBERSICHT" Foreground="#FFC95452" FontWeight="Bold" FontSize="11"/>
                                <TextBlock Text="Deine Vio-V-Informationen" FontSize="21" FontWeight="Bold" Margin="0,7,0,5"/>
                                <TextBlock x:Name="HomeProfileStatus" Text="Spielerdaten werden über die Vio-V-API geladen …" Foreground="#FFB7B7B7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="3" Rows="2" Margin="0,0,0,14">
                            <Border Background="#FF292929" CornerRadius="9" Padding="14" Margin="0,0,8,8"><StackPanel><TextBlock Text="Spieler-ID" Foreground="#FF999999"/><TextBlock x:Name="ProfileIdText" Text="—" FontSize="20" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Border>
                            <Border Background="#FF292929" CornerRadius="9" Padding="14" Margin="0,0,8,8"><StackPanel><TextBlock Text="Nutzername" Foreground="#FF999999"/><TextBlock x:Name="ProfileUsernameText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Background="#FF292929" CornerRadius="9" Padding="14" Margin="0,0,0,8"><StackPanel><TextBlock Text="Spielzeit" Foreground="#FF999999"/><TextBlock x:Name="ProfilePlaytimeText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                            <Border Background="#FF292929" CornerRadius="9" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Gruppe / Fraktion" Foreground="#FF999999"/><TextBlock x:Name="ProfileGroupText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Background="#FF292929" CornerRadius="9" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Gruppenrang" Foreground="#FF999999"/><TextBlock x:Name="ProfileRankText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Background="#FF292929" CornerRadius="9" Padding="14"><StackPanel><TextBlock Text="Nickchanges" Foreground="#FF999999"/><TextBlock x:Name="ProfileNickChangesText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                        </UniformGrid>
                        <Border Background="#FF292929" CornerRadius="10" Padding="16">
                            <StackPanel><TextBlock Text="SCHNELLZUGRIFF" FontWeight="Bold" Foreground="#FFC95452"/><WrapPanel Margin="0,12,0,0"><Button Content="Overlay 1 öffnen" Click="ShowOverlay1_Click" Margin="0,0,8,8"/><Button Content="Overlay 2 öffnen" Click="ShowOverlay2_Click" Margin="0,0,8,8"/><Button Content="Overlay 3 öffnen" Click="ShowOverlay3_Click" Margin="0,0,8,8"/><Button Content="Shortcuts verwalten" Click="NavShortcuts_Click" Margin="0,0,8,8"/></WrapPanel></StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="OverlayPage" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="OverlayEditor1" Grid.Column="0" Background="#FF292929" CornerRadius="10" Padding="14" Visibility="Visible">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="OVERLAY 1" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox x:Name="MessageBox1" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontSize="14" Padding="9" MinHeight="130"
                             Background="#FF1C1C1C" Foreground="#FFF2F4F8" BorderBrush="#FF414141" CaretBrush="White"/>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="FontSizeLabel1" Text="Schriftgröße: 28" Foreground="#FFB7B7B7"
                                       VerticalAlignment="Center" Width="112"/>
                            <Slider x:Name="FontSizeSlider1" Minimum="12" Maximum="72" Value="28"
                                    TickFrequency="2" IsSnapToTickEnabled="False"
                                    ValueChanged="FontSizeSlider_ValueChanged" Tag="1"
                                    VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0" LastChildFill="True">
                            <TextBlock Text="Textfarbe:" Foreground="#FFB7B7B7" VerticalAlignment="Center" Width="112"/>
                            <ComboBox x:Name="TextColorCombo1" Tag="1" SelectionChanged="TextColorCombo_SelectionChanged"
                                      Padding="5" Background="#FF1C1C1C" Foreground="#FFF2F4F8" BorderBrush="#FF414141">
                                <ComboBoxItem Content="Weiß" Tag="#FFFFFFFF"/>
                                <ComboBoxItem Content="Rot" Tag="#FFFF5555"/>
                                <ComboBoxItem Content="Grün" Tag="#FF55FF77"/>
                                <ComboBoxItem Content="Blau" Tag="#FF5599FF"/>
                                <ComboBoxItem Content="Gelb" Tag="#FFFFFF55"/>
                                <ComboBoxItem Content="Türkis" Tag="#FF55FFFF"/>
                                <ComboBoxItem Content="Orange" Tag="#FFFFA040"/>
                                <ComboBoxItem Content="Pink" Tag="#FFFF66CC"/>
                                <ComboBoxItem Content="Lila" Tag="#FFBB88FF"/>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <Button Content="Anzeigen (NUMPAD 1)" Click="ShowOverlay1_Click" Padding="9"
                                Background="#FFAE3F3D" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                        <Button Content="Ausblenden" Click="HideOverlay1_Click" Margin="0,7,0,0" Padding="8"
                                Background="#FF3A3A3A" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border><Border x:Name="OverlayEditor2" Grid.Column="0" Background="#FF292929" CornerRadius="10" Padding="14" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="OVERLAY 2" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox x:Name="MessageBox2" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontSize="14" Padding="9" MinHeight="130"
                             Background="#FF1C1C1C" Foreground="#FFF2F4F8" BorderBrush="#FF414141" CaretBrush="White"/>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="FontSizeLabel2" Text="Schriftgröße: 28" Foreground="#FFB7B7B7"
                                       VerticalAlignment="Center" Width="112"/>
                            <Slider x:Name="FontSizeSlider2" Minimum="12" Maximum="72" Value="28"
                                    TickFrequency="2" IsSnapToTickEnabled="False"
                                    ValueChanged="FontSizeSlider_ValueChanged" Tag="2"
                                    VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0" LastChildFill="True">
                            <TextBlock Text="Textfarbe:" Foreground="#FFB7B7B7" VerticalAlignment="Center" Width="112"/>
                            <ComboBox x:Name="TextColorCombo2" Tag="2" SelectionChanged="TextColorCombo_SelectionChanged"
                                      Padding="5" Background="#FF1C1C1C" Foreground="#FFF2F4F8" BorderBrush="#FF414141">
                                <ComboBoxItem Content="Weiß" Tag="#FFFFFFFF"/>
                                <ComboBoxItem Content="Rot" Tag="#FFFF5555"/>
                                <ComboBoxItem Content="Grün" Tag="#FF55FF77"/>
                                <ComboBoxItem Content="Blau" Tag="#FF5599FF"/>
                                <ComboBoxItem Content="Gelb" Tag="#FFFFFF55"/>
                                <ComboBoxItem Content="Türkis" Tag="#FF55FFFF"/>
                                <ComboBoxItem Content="Orange" Tag="#FFFFA040"/>
                                <ComboBoxItem Content="Pink" Tag="#FFFF66CC"/>
                                <ComboBoxItem Content="Lila" Tag="#FFBB88FF"/>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <Button Content="Anzeigen (NUMPAD 2)" Click="ShowOverlay2_Click" Padding="9"
                                Background="#FFAE3F3D" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                        <Button Content="Ausblenden" Click="HideOverlay2_Click" Margin="0,7,0,0" Padding="8"
                                Background="#FF3A3A3A" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border><Border x:Name="OverlayEditor3" Grid.Column="0" Background="#FF292929" CornerRadius="10" Padding="14" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="OVERLAY 3" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox x:Name="MessageBox3" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontSize="14" Padding="9" MinHeight="130"
                             Background="#FF1C1C1C" Foreground="#FFF2F4F8" BorderBrush="#FF414141" CaretBrush="White"/>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="FontSizeLabel3" Text="Schriftgröße: 28" Foreground="#FFB7B7B7"
                                       VerticalAlignment="Center" Width="112"/>
                            <Slider x:Name="FontSizeSlider3" Minimum="12" Maximum="72" Value="28"
                                    TickFrequency="2" IsSnapToTickEnabled="False"
                                    ValueChanged="FontSizeSlider_ValueChanged" Tag="3"
                                    VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0" LastChildFill="True">
                            <TextBlock Text="Textfarbe:" Foreground="#FFB7B7B7" VerticalAlignment="Center" Width="112"/>
                            <ComboBox x:Name="TextColorCombo3" Tag="3" SelectionChanged="TextColorCombo_SelectionChanged"
                                      Padding="5" Background="#FF1C1C1C" Foreground="#FFF2F4F8" BorderBrush="#FF414141">
                                <ComboBoxItem Content="Weiß" Tag="#FFFFFFFF"/>
                                <ComboBoxItem Content="Rot" Tag="#FFFF5555"/>
                                <ComboBoxItem Content="Grün" Tag="#FF55FF77"/>
                                <ComboBoxItem Content="Blau" Tag="#FF5599FF"/>
                                <ComboBoxItem Content="Gelb" Tag="#FFFFFF55"/>
                                <ComboBoxItem Content="Türkis" Tag="#FF55FFFF"/>
                                <ComboBoxItem Content="Orange" Tag="#FFFFA040"/>
                                <ComboBoxItem Content="Pink" Tag="#FFFF66CC"/>
                                <ComboBoxItem Content="Lila" Tag="#FFBB88FF"/>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <Button Content="Anzeigen (NUMPAD 3)" Click="ShowOverlay3_Click" Padding="9"
                                Background="#FFAE3F3D" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                        <Button Content="Ausblenden" Click="HideOverlay3_Click" Margin="0,7,0,0" Padding="8"
                                Background="#FF3A3A3A" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>
                </Grid>
                <ScrollViewer x:Name="ShortcutsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#FF292929" BorderBrush="#FF414141" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel><TextBlock Text="GLOBALE TASTEN" Foreground="#FFC95452" FontWeight="Bold"/><TextBlock Text="NUMPAD 1  ·  Overlay 1 anzeigen" Margin="0,12,0,0"/><TextBlock Text="NUMPAD 2  ·  Overlay 2 anzeigen" Margin="0,7,0,0"/><TextBlock Text="NUMPAD 3  ·  Overlay 3 anzeigen" Margin="0,7,0,0"/><TextBlock Text="NUMPAD 0  ·  Aktives Overlay ein-/ausblenden" Margin="0,7,0,0" Foreground="#FFB7B7B7"/></StackPanel>
                        </Border>
                        <Border Background="#FF292929" BorderBrush="#FF414141" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel><TextBlock Text="EIGENE CHAT-BEFEHLE" FontSize="18" FontWeight="Bold"/><TextBlock Text="Lege Kürzel wie /br fest und ersetze sie durch einen längeren Text. Die Einfügemarke kann mit {cursor} gesetzt werden." Foreground="#FFB7B7B7" TextWrapping="Wrap" Margin="0,7,0,16"/><Button Content="Chat-Befehle konfigurieren" Click="ConfigureChatCommands_Click" HorizontalAlignment="Left"/></StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#FF292929" BorderBrush="#FF414141" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel><TextBlock Text="OVERLAY-VERHALTEN" FontSize="18" FontWeight="Bold"/><CheckBox x:Name="LockOverlaysCheckBox" Content="Alle Overlays fixieren (Maus an das Spiel durchlassen)" Checked="LockOverlays_Changed" Unchecked="LockOverlays_Changed" Margin="0,15,0,0" Foreground="#FFF2F4F8"/><Button Content="Alle Overlays ausblenden" Click="HideBoth_Click" HorizontalAlignment="Left" Margin="0,15,0,0" Background="#FF3A3A3A"/></StackPanel>
                        </Border>
                        <Border Background="#FF292929" BorderBrush="#FF414141" BorderThickness="1" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="SPEICHERN" FontSize="18" FontWeight="Bold"/><TextBlock Text="Speichert Texte, Schriftgrößen, Positionen und Overlay-Einstellungen lokal auf diesem PC." Foreground="#FFB7B7B7" TextWrapping="Wrap" Margin="0,7,0,14"/><Button Content="Einstellungen speichern" Click="Save_Click" HorizontalAlignment="Left"/></StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="2" Background="#FF292929" CornerRadius="7" Padding="9,7" Margin="0,14,0,0">
                <TextBlock x:Name="StatusText" Text="Bereit. Globale Hotkeys werden beim Start registriert." Foreground="#FFB7B7B7" FontSize="11"/>
            </Border>
        </Grid>
    </Grid>
</Window>