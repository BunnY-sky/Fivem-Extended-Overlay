<Window x:Class="FiveMOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" SizeToContent="Manual"
        Width="500" Height="110" MinWidth="120" MinHeight="48"
        ResizeMode="NoResize" ShowActivated="False">
    <Border x:Name="Panel" CornerRadius="10" Padding="18,12" BorderThickness="1"
            BorderBrush="#66FFFFFF" ClipToBounds="True">
        <Grid>
            <TextBlock x:Name="OverlayText" Text="Deine Nachricht steht hier."
                       TextWrapping="NoWrap" FontSize="28" FontWeight="SemiBold" FontFamily="Segoe UI"
                       LineStackingStrategy="BlockLineHeight"
                       Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Grid x:Name="TableContent" Visibility="Collapsed" Margin="0,0,8,0"/>
            <Thumb x:Name="ResizeGrip" Width="18" Height="18"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" DragDelta="ResizeGrip_DragDelta"
                   Background="Transparent">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path Data="M 16,2 L 16,16 L 2,16" Stroke="#BFFFFFFF"
                                  StrokeThickness="2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
